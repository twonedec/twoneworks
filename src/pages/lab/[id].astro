---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const labPosts = await getCollection('lab', ({ data }) => !data.draft);
  return labPosts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 연관 콘텐츠 추천 (작업기 및 다른 자료실 글)
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const allLab = await getCollection('lab', ({ data }) => !data.draft && data.title !== post.data.title);

// 블로그 키워드 관련 자료실 글이면 키워드 추출기 작업기를 최우선 노출
const isBlogTopic = post.id.includes('blog') || (post.data.tags && post.data.tags.some(t => t.includes('블로그') || t.includes('키워드')));
const relatedPostItem = isBlogTopic ? allPosts.find(p => p.id.includes('keyword-extractor')) : allPosts[0];

// 다른 자료실 글 중 2개 추천
const otherLabItems = allLab.filter(item => isBlogTopic ? item.id.includes('blog') : !item.id.includes('blog')).slice(0, 2);
if (otherLabItems.length < 2) {
  const remaining = allLab.filter(item => !otherLabItems.includes(item)).slice(0, 2 - otherLabItems.length);
  otherLabItems.push(...remaining);
}

const isStockPost = post.id.includes('stock') || (post.data.tags && post.data.tags.some(t => t.includes('주식') || t.includes('퀀트')));

// CTA 박스 동적 분기
const ctaEyebrow = isStockPost ? "TWONEWORKS QUANT ENGINE" : "TWONEWORKS AUTOMATION";
const ctaTitle = isStockPost
  ? "전 종목을 전수 스크리닝하는 실전 퀀트 자동화 시스템"
  : "반복 작업을 1초로 압축하는 전용 자동화 솔루션";
const ctaDesc = isStockPost
  ? "DART 전자공시 재무제표와 주가를 실시간 연동해 피터 린치 GARP, 버핏 안전마진, 외인/기관 세력 수급까지 3중으로 전 종목을 자동 스크리닝하는 twonelab 퀀트 시스템과 구축 노하우를 확인해보세요."
  : "매번 손으로 복사하고 정리할 필요 없이, 시드 키워드 전수조사부터 3중 필터링, 상업성 지표 산출까지 엑셀로 원클릭 완성해 주는 twonelab의 영구소장용 윈도우 무제한 프로그램을 크몽에서 만나보세요.";
const ctaBtnText = isStockPost
  ? "크몽 퀀트 자동화 노하우 보기 ↗"
  : "크몽에서 솔루션 상세 보기 ↗";
const ctaUrl = isStockPost
  ? "https://kmong.com/gig/784398"
  : "https://kmong.com/gig/785584";

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${post.data.title} — twonelab 공식 자료실`} description={post.data.summary}>
<style is:global>
.lab-wrap {
  max-width: 820px;
  margin: 0 auto;
  padding: 56px 24px 96px;
}

.lab-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.lab-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
  text-decoration: none !important;
  transition: color 0.2s;
}
.lab-back-link:hover {
  color: var(--ink);
}
.lab-category-tag {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ink-2);
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 3px 8px;
  border-radius: 4px;
}

.lab-header {
  margin-bottom: 40px;
}
.lab-title {
  font-family: var(--sans);
  font-weight: 700;
  font-size: clamp(26px, 3.5vw, 36px);
  line-height: 1.35;
  letter-spacing: -0.025em;
  color: var(--ink);
  margin-bottom: 16px;
}
.lab-lead {
  font-size: 16px;
  line-height: 1.7;
  color: var(--ink-2);
  font-weight: 400;
}
.lab-meta {
  margin-top: 14px;
  font-family: var(--mono);
  font-size: 11.5px;
  color: var(--muted);
}

.lab-body {
  font-size: 16px;
  line-height: 1.8;
  color: var(--ink);
}
.lab-body h2 {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 22px;
  margin: 2.4em 0 0.8em;
  padding-bottom: 10px;
  border-bottom: 1px solid var(--line);
}
.lab-body h3 {
  font-family: var(--sans);
  font-weight: 600;
  font-size: 18px;
  margin: 1.8em 0 0.6em;
}
.lab-body p {
  margin-bottom: 1.4em;
}

/* ── Code Box ────────────────────────────────────── */
.lab-code-box {
  margin: 2em 0;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #334155;
  background: #0f172a;
}
.lab-code-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 16px;
  background: #1e293b;
  border-bottom: 1px solid #334155;
  font-family: var(--mono);
  font-size: 11.5px;
  color: #94a3b8;
}
.lab-copy-btn {
  background: #3b82f6;
  color: #fff;
  border: none;
  padding: 5px 14px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}
.lab-copy-btn:hover {
  background: #2563eb;
}
.lab-copy-btn.copied {
  background: #10b981;
}
.lab-code-box pre {
  margin: 0 !important;
  padding: 20px !important;
  border: none !important;
  border-radius: 0 !important;
  background: transparent !important;
  overflow-x: auto;
  font-family: var(--mono);
  font-size: 13.5px;
  line-height: 1.65;
  color: #e2e8f0;
}

/* ── Kmong CTA Box ───────────────────────────────── */
.kmong-cta-box {
  margin: 56px 0 40px;
  padding: 36px 32px;
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  border-radius: 12px;
  text-align: center;
}
.kmong-cta-eyebrow {
  font-family: var(--mono);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: #0284c7;
  text-transform: uppercase;
  margin-bottom: 10px;
}
.kmong-cta-title {
  font-family: var(--sans);
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12px;
}
.kmong-cta-desc {
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--ink-2);
  max-width: 600px;
  margin: 0 auto 24px;
}
.kmong-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #0284c7;
  color: #fff;
  font-weight: 600;
  font-size: 14.5px;
  padding: 12px 28px;
  border-radius: 6px;
  text-decoration: none !important;
  transition: opacity 0.2s;
}
.kmong-cta-btn:hover {
  opacity: 0.9;
}
/* ── Related / 다른 글 카드 섹션 ─────────────────── */
.lab-related-section {
  margin-top: 64px;
  padding-top: 48px;
  border-top: 1px solid var(--line);
}
.lab-related-header {
  margin-bottom: 24px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.lab-related-title {
  font-family: var(--sans);
  font-size: 18px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.015em;
}
.lab-related-sub {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.lab-related-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.related-item-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none !important;
  transition: transform 0.25s var(--ease-out), border-color 0.25s, box-shadow 0.25s;
}
.related-item-card:hover {
  transform: translateY(-4px);
  border-color: var(--line-s);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
}
.related-item-thumb-box {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #0f172a;
  overflow: hidden;
  position: relative;
}
.related-item-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.related-item-card:hover .related-item-thumb {
  transform: scale(1.03);
}
.related-item-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.related-item-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  font-family: var(--mono);
  font-size: 11px;
}
.related-item-badge {
  color: #0284c7;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.related-item-badge.note {
  color: #10b981;
}
.related-item-title {
  font-family: var(--sans);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.related-item-desc {
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--ink-2);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.related-item-link-text {
  margin-top: auto;
  padding-top: 14px;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  color: #0284c7;
  display: flex;
  align-items: center;
  gap: 4px;
}

@media (max-width: 640px) {
  .lab-related-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="lab-wrap">
  <!-- 상단 네비게이션 -->
  <div class="lab-nav-bar">
    <a href="/" class="lab-back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M19 12H5M12 19l-7-7 7-7"/>
      </svg>
      <span>Twoneworks 홈으로</span>
    </a>
    <span class="lab-category-tag">{post.data.categoryBadge || 'TWONELAB'}</span>
  </div>

  <!-- 헤더 -->
  <header class="lab-header">
    <h1 class="lab-title">{post.data.title}</h1>
    <p class="lab-lead">{post.data.summary}</p>
    <div class="lab-meta">배포일: {formattedDate}</div>
  </header>

  <!-- 본문 -->
  <article class="lab-body">
    <Content />
  </article>

  <!-- 연관 작업기 및 추천 자료 카드 섹션 -->
  <section class="lab-related-section">
    <div class="lab-related-header">
      <h3 class="lab-related-title">함께 읽어볼 만한 실전 기록 & 도구</h3>
      <span class="lab-related-sub">RELATED NOTES & TOOLS</span>
    </div>

    <div class="lab-related-grid">
      {relatedPostItem && (
        <a href={`/posts/${relatedPostItem.id}/`} class="related-item-card">
          <div class="related-item-thumb-box">
            <img 
              src={relatedPostItem.data.thumbnail || "/images/lab/thumb-post-01-keyword-extractor.png"} 
              alt={relatedPostItem.data.title} 
              class="related-item-thumb" 
              loading="lazy" 
            />
          </div>
          <div class="related-item-content">
            <div class="related-item-meta">
              <span class="related-item-badge note">작업 기록 · NOTE</span>
              <span style="color:var(--muted);">·</span>
              <span style="color:var(--muted);">{relatedPostItem.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <h4 class="related-item-title">{relatedPostItem.data.title}</h4>
            <p class="related-item-desc">{relatedPostItem.data.summary}</p>
            <div class="related-item-link-text">제작 과정 & 영상 보기 →</div>
          </div>
        </a>
      )}

      {otherLabItems.map(item => (
        <a href={`/lab/${item.id}/`} class="related-item-card">
          <div class="related-item-thumb-box">
            <img 
              src={item.data.thumbnail || "/images/lab/thumb-01-blog-volume.png"} 
              alt={item.data.title} 
              class="related-item-thumb" 
              loading="lazy" 
            />
          </div>
          <div class="related-item-content">
            <div class="related-item-meta">
              <span class="related-item-badge">{item.data.categoryBadge || 'TWONELAB'}</span>
              <span style="color:var(--muted);">·</span>
              <span style="color:var(--muted);">{item.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            </div>
            <h4 class="related-item-title">{item.data.title}</h4>
            <p class="related-item-desc">{item.data.summary}</p>
            <div class="related-item-link-text">파이썬 코드 & 노하우 확인 →</div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 크몽 솔루션 배너 -->
  <div class="kmong-cta-box">
    <div class="kmong-cta-eyebrow">{ctaEyebrow}</div>
    <h3 class="kmong-cta-title">{ctaTitle}</h3>
    <p class="kmong-cta-desc">{ctaDesc}</p>
    <a href={ctaUrl} target="_blank" rel="noopener noreferrer" class="kmong-cta-btn">
      {ctaBtnText}
    </a>
  </div>
</div>

<!-- 원클릭 복사 스크립트 -->
<script is:inline>
document.addEventListener('DOMContentLoaded', () => {
  const codeBlocks = document.querySelectorAll('.lab-body pre');
  codeBlocks.forEach((pre) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'lab-code-box';

    const header = document.createElement('div');
    header.className = 'lab-code-header';
    header.innerHTML = `
      <span>TWONELAB RESOURCE</span>
      <button type="button" class="lab-copy-btn">복사하기</button>
    `;

    pre.parentNode.insertBefore(wrapper, pre);
    wrapper.appendChild(header);
    wrapper.appendChild(pre);

    const btn = header.querySelector('.lab-copy-btn');
    btn.addEventListener('click', () => {
      const code = pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText;
      navigator.clipboard.writeText(code.trim()).then(() => {
        btn.classList.add('copied');
        btn.innerText = '복사 완료! ✓';
        setTimeout(() => {
          btn.classList.remove('copied');
          btn.innerText = '복사하기';
        }, 2000);
      });
    });
  });
});
</script>
</Layout>

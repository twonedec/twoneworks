---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = "Twoneworks — 필요한 도구를 직접 만드는 개인 작업실",
  ogImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site).href
  : new URL('/thumbnail.png', Astro.site).href;
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:image"       content={ogImageURL} />
  <meta property="og:locale"      content="ko_KR" />
  <meta name="twitter:card"       content="summary_large_image" />
  <meta name="twitter:title"      content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"      content={ogImageURL} />
  <meta name="naver-site-verification" content="5443b7c46474b59e8374a364c9de4f973e13fbcb" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Twoneworks",
    "url": Astro.site?.href,
    "description": description
  })} />
</head>
<body>

  <!-- Cursor -->
  <div id="cursor-dot"  aria-hidden="true"></div>
  <div id="cursor-ring" aria-hidden="true"></div>

  <!-- Navigation (자료실 미노출 - 순수 스튜디오 메뉴만 구성) -->
  <header class="site-nav">
    <a href="/" class="nav-brand">
      <span class="nav-mark">T</span>
      <span class="nav-name-ko">Twoneworks</span>
      <span class="nav-name-en">&ensp;— 작업실</span>
    </a>
    <nav class="nav-links" aria-label="메인 메뉴">
      <a href="/">Home</a>
      <a href="/posts/">Notes</a>
      <a href="/about/">About</a>
    </nav>
    <div class="nav-right">
      <span id="nav-season" style="font-size:11px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)"></span>
    </div>
    <script>
      (function() {
        const m = new Date().getMonth() + 1;
        const y = new Date().getFullYear();
        const s = m >= 3 && m <= 5 ? '봄' : m >= 6 && m <= 8 ? '여름' : m >= 9 && m <= 11 ? '가을' : '겨울';
        const el = document.getElementById('nav-season');
        if (el) el.textContent = s + ' ' + y;
      })();
    </script>
    <button class="nav-hamburger" id="hamburger" aria-label="메뉴 열기" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>
  </header>

  <!-- Mobile nav panel -->
  <nav class="nav-mobile-panel" id="mobile-nav" aria-label="모바일 메뉴">
    <a href="/">Home</a>
    <a href="/posts/">Notes</a>
    <a href="/about/">About</a>
  </nav>

  <!-- Page content -->
  <main>
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-brand">
      <div class="brand">
        <span class="nav-mark" style="width:24px;height:24px;font-size:14px">T</span>
        <span>Twoneworks</span>
      </div>
      <p class="colophon">필요한 도구는 직접 만들고,<br>실전에서 검증하고 씁니다.<br>개인 작업실.</p>
    </div>
    <div>
      <h6>바로가기</h6>
      <ul>
        <li><a href="/">홈 (Home)</a></li>
        <li><a href="/posts/">기록 (Notes)</a></li>
        <li><a href="/about/">소개 (About)</a></li>
      </ul>
    </div>
    <div>
      <h6>프로젝트 & 도구</h6>
      <ul>
        <li><a href="https://kmong.com/gig/785584" target="_blank" rel="noopener">키워드 추출기 ↗</a></li>
        <li><a href="https://kmong.com/gig/784398" target="_blank" rel="noopener">주식 퀀트 스크리너 ↗</a></li>
      </ul>
    </div>
    <div class="footer-copy">
      <span>© {new Date().getFullYear()} Twoneworks. All rights reserved.</span>
      <span>Built on Astro</span>
    </div>
  </footer>

  <script>
    /* ── Custom Cursor ── */
    const dot  = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');

    if (dot && ring && window.matchMedia('(pointer: fine)').matches) {
      let mx = -100, my = -100, rx = -100, ry = -100;

      document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
      document.addEventListener('mousedown', () => document.body.classList.add('cursor-active'));
      document.addEventListener('mouseup',   () => document.body.classList.remove('cursor-active'));

      document.querySelectorAll('a, button, [role="button"], .card').forEach(el => {
        el.addEventListener('mouseenter', () => document.body.classList.add('cursor-hover'));
        el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-hover'));
      });

      (function animCursor() {
        rx += (mx - rx) * 0.12;
        ry += (my - ry) * 0.12;
        dot.style.left  = mx + 'px';
        dot.style.top   = my + 'px';
        ring.style.left = rx + 'px';
        ring.style.top  = ry + 'px';
        requestAnimationFrame(animCursor);
      })();
    }

    /* ── Scroll Reveal ── */
    const io = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));

    /* ── Mobile hamburger ── */
    const btn   = document.getElementById('hamburger');
    const panel = document.getElementById('mobile-nav');
    if (btn && panel) {
      btn.addEventListener('click', () => {
        const open = panel.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? '메뉴 닫기' : '메뉴 열기');
      });
      panel.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', () => {
          panel.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        });
      });
    }
  </script>

</body>
</html>

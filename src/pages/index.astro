---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latestPosts = posts.slice(0, 3);
---

<Layout title="Twoneworks — 필요한 도구를 직접 만드는 개인 작업실">
<style>
/* ── Masthead ───────────────────────────────────────── */
.masthead {
  padding: 88px 56px 80px;
  border-bottom: 1px solid var(--line);
}
.masthead-strip {
  display: flex; justify-content: space-between; align-items: baseline;
  border-bottom: 1px solid var(--line);
  padding-bottom: 16px; margin-bottom: 56px;
  font-family: var(--mono); font-size: 11px; color: var(--muted);
  letter-spacing: .12em; text-transform: uppercase;
}
.hero-inner {
  max-width: 860px;
}
.hero-eyebrow {
  font-family: var(--mono);
  font-size: 11px; font-weight: 700; letter-spacing: .22em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 24px;
}
.hero-title {
  font-family: var(--sans); font-weight: 700;
  font-size: clamp(38px, 5.5vw, 64px);
  line-height: 1.15; letter-spacing: -.03em; color: var(--ink);
  margin-bottom: 32px;
}
.hero-title em {
  font-style: normal;
  color: #0284c7;
}
.hero-body {
  font-size: 18px; line-height: 1.8;
  color: var(--ink-2); font-weight: 400; max-width: 720px;
  margin-bottom: 40px;
}

/* ── Focus Areas ─────────────────────────────────────── */
.section {
  padding: 88px 56px;
  border-bottom: 1px solid var(--line);
}
.section-head {
  margin-bottom: 48px;
}
.section-title {
  font-family: var(--sans); font-weight: 700;
  font-size: 26px; letter-spacing: -.02em; color: var(--ink);
  display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px;
}
.sub-en {
  font-family: var(--mono);
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  letter-spacing: .08em;
  text-transform: uppercase;
}
.grid-3 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
}
.focus-card {
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 32px 28px;
  display: flex;
  flex-direction: column;
  gap: 16px;
  transition: transform .3s var(--ease-out), border-color .3s;
}
.focus-card:hover {
  transform: translateY(-4px);
  border-color: var(--line-s);
}
.focus-num {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  letter-spacing: .08em;
}
.focus-title {
  font-family: var(--sans);
  font-size: 20px;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -.015em;
}
.focus-desc {
  font-size: 14.5px;
  line-height: 1.7;
  color: var(--ink-2);
}

/* ── Tools ─────────────────────────────────────────── */
.solution-box {
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  border-radius: 16px;
  padding: 48px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 32px;
  margin-top: 24px;
}
.solution-info h3 {
  font-family: var(--sans);
  font-size: 22px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 10px;
}
.solution-info p {
  font-size: 15px;
  color: var(--ink-2);
  line-height: 1.6;
}
.solution-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--ink);
  color: var(--bg-elev);
  padding: 14px 28px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14.5px;
  text-decoration: none !important;
  white-space: nowrap;
  transition: opacity .2s;
}
.solution-btn:hover {
  opacity: .88;
}

@media (max-width: 900px) {
  .grid-3 { grid-template-columns: 1fr; }
  .solution-box { flex-direction: column; align-items: flex-start; }
  .masthead, .section { padding-left: 24px; padding-right: 24px; }
}
</style>

<!-- Masthead -->
<section class="masthead">
  <div class="masthead-strip reveal">
    <span>TWONEWORKS</span>
    <span>{new Date().toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
  </div>

  <div class="hero-inner">
    <p class="hero-eyebrow reveal">개인 작업실 · PERSONAL WORKSPACE</p>
    <h1 class="hero-title reveal" style="transition-delay:.1s">
      필요한 도구는 직접 만들고,<br>
      실전에서 <em>검증하고 씁니다</em>.
    </h1>
    <p class="hero-body reveal" style="transition-delay:.2s">
      일상의 반복 작업을 줄이는 데이터 자동화 스크립트부터 주식 퀀트 분석, 홈서버와 ESP32 소형 기기까지 직접 만들어보고 기록하는 개인 작업실입니다.
    </p>
  </div>
</section>

<!-- Focus Areas -->
<section class="section">
  <div class="section-head reveal">
    <h2 class="section-title">
      만들고 다루는 것들
      <span class="sub-en">What I Build</span>
    </h2>
  </div>

  <div class="grid-3">
    <div class="focus-card reveal">
      <span class="focus-num">01 / 데이터 자동화 · AUTOMATION</span>
      <h3 class="focus-title">데이터 수집 & 자동화 스크립트</h3>
      <p class="focus-desc">
        반복되는 수작업을 줄이기 위해 네이버 검색광고 API 기반 키워드 추출과 자동 분석 도구들을 만듭니다.
      </p>
    </div>

    <div class="focus-card reveal" style="transition-delay:.08s">
      <span class="focus-num">02 / 주식 퀀트 · QUANT</span>
      <h3 class="focus-title">퀀트 데이터 & 투자 스크리너</h3>
      <p class="focus-desc">
        DART 전자공시 재무제표와 주가 데이터를 연결해 직접 투자에 활용하고 검증하는 스크리너를 연구합니다.
      </p>
    </div>

    <div class="focus-card reveal" style="transition-delay:.16s">
      <span class="focus-num">03 / 인프라 & 홈랩 · INFRA & IOT</span>
      <h3 class="focus-title">홈서버 환경 & ESP32 DIY</h3>
      <p class="focus-desc">
        시놀로지 NAS와 홈랩 환경, 그리고 실생활에서 재미있게 쓸 수 있는 ESP32 소형 기기들을 만지작거립니다.
      </p>
    </div>
  </div>
</section>

<!-- Tools Showcase -->
<section class="section">
  <div class="section-head reveal">
    <h2 class="section-title">
      만들어둔 도구
      <span class="sub-en">Tools</span>
    </h2>
  </div>

  <div style="display:flex; flex-direction:column; gap:20px;">
    <div class="solution-box reveal">
      <div class="solution-info">
        <h3>네이버 블로그 키워드 추출기</h3>
        <p>
          시드 키워드 자동 확장부터 검색량·발행일자 분석까지 엑셀로 한 번에 정리하는 실전용 도구입니다.
        </p>
      </div>
      <a href="https://kmong.com/gig/785584" target="_blank" rel="noopener noreferrer" class="solution-btn">
        크몽에서 살펴보기 ↗
      </a>
    </div>

    <div class="solution-box reveal" style="transition-delay:.08s">
      <div class="solution-info">
        <h3>주식 퀀트 & GARP 스크리너</h3>
        <p>
          DART 전자공시 재무제표와 시장 데이터를 연결해 피터 린치 성장가치주와 수급을 선별하는 퀀트 분석 시스템입니다.
        </p>
      </div>
      <a href="https://kmong.com/gig/784398" target="_blank" rel="noopener noreferrer" class="solution-btn">
        크몽에서 살펴보기 ↗
      </a>
    </div>
  </div>
</section>

<!-- Recent Notes / 기록 -->
{latestPosts.length > 0 && (
<section class="section">
  <div class="section-head reveal" style="display:flex; justify-content:space-between; align-items:flex-end;">
    <h2 class="section-title">
      최근 작업기
      <span class="sub-en">Recent Notes</span>
    </h2>
    <a href="/posts/" style="font-family:var(--mono); font-size:12px; color:var(--muted); text-decoration:none; padding-bottom:4px;">전체 보기 →</a>
  </div>

  <div style="display:flex; flex-direction:column; gap:16px;">
    {latestPosts.map(post => (
      <a href={`/posts/${post.id}/`} class="solution-box reveal" style="text-decoration:none !important; padding:24px 28px; margin-top:0; transition:transform .25s var(--ease-out), border-color .25s;">
        {post.data.thumbnail && (
          <div style="width:200px; min-width:200px; aspect-ratio:16/9; border-radius:8px; overflow:hidden; background:#0f172a;">
            <img src={post.data.thumbnail} alt={post.data.title} style="width:100%; height:100%; object-fit:cover;" loading="lazy" />
          </div>
        )}
        <div class="solution-info" style="flex:1;">
          <div style="display:flex; gap:10px; align-items:center; margin-bottom:10px; font-family:var(--mono); font-size:11.5px;">
            <span style="color:#0284c7; font-weight:600; letter-spacing:.06em;">{post.data.category}</span>
            <span style="color:var(--muted);">·</span>
            <time style="color:var(--muted);">{post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
          </div>
          <h3 style="margin-bottom:8px; font-size:20px; color:var(--ink);">{post.data.title}</h3>
          <p style="margin:0; font-size:14.5px; color:var(--ink-2); line-height:1.65;">{post.data.summary}</p>
        </div>
        <span style="font-family:var(--mono); font-size:13px; font-weight:600; color:var(--ink); white-space:nowrap; margin-left:16px;">
          읽기 →
        </span>
      </a>
    ))}
  </div>
</section>
)}
</Layout>

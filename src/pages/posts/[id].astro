---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// 연관 자료실 글 및 다른 포스트 가져오기
const allLab = await getCollection('lab', ({ data }) => !data.draft);
const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.title !== post.data.title);

// 블로그 주제면 블로그 키워드 자료실 글들을 추천
const isBlogTopic = post.id.includes('blog') || (post.data.tags && post.data.tags.some(t => t.includes('블로그') || t.includes('키워드')));
const relatedLabList = allLab.filter(item => isBlogTopic ? item.id.includes('blog') : true).slice(0, 2);

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${post.data.title} — Twoneworks`} description={post.data.summary}>
<style is:global>
.post-wrap {
  max-width: 780px;
  margin: 0 auto;
  padding: 64px 24px 112px;
}

.post-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.post-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.08em;
  color: var(--muted);
  text-decoration: none !important;
  transition: color .2s;
}
.post-back-link:hover {
  color: var(--ink);
}
.post-badge {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #0284c7;
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 4px 10px;
  border-radius: 6px;
  font-weight: 600;
}

.post-header {
  margin-bottom: 48px;
}
.post-title {
  font-family: var(--sans);
  font-weight: 700;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.3;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin-bottom: 20px;
}
.post-lead {
  font-size: 17px;
  line-height: 1.75;
  color: var(--ink-2);
  font-weight: 400;
  margin-bottom: 18px;
}
.post-meta {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  display: flex;
  gap: 16px;
}

.post-body {
  font-size: 16.5px;
  line-height: 1.85;
  color: var(--ink);
}
.post-body h2 {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.02em;
  margin: 2.6em 0 0.9em;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
  color: var(--ink);
}
.post-body h3 {
  font-family: var(--sans);
  font-weight: 600;
  font-size: 19px;
  letter-spacing: -0.015em;
  margin: 2em 0 0.7em;
  color: var(--ink);
}
.post-body p {
  margin-bottom: 1.5em;
}
.post-body ol, .post-body ul {
  margin: 1.2em 0 1.6em 1.4em;
  padding: 0;
}
.post-body li {
  margin-bottom: 0.6em;
  line-height: 1.75;
}
.post-body hr {
  border: 0;
  border-top: 1px solid var(--line);
  margin: 3.5em 0;
}
.post-body blockquote {
  margin: 2em 0;
  padding: 20px 24px;
  background: var(--bg-soft);
  border-left: 3px solid #0284c7;
  border-radius: 0 8px 8px 0;
  font-size: 15.5px;
  color: var(--ink-2);
}

/* ── Media Box (Images & Videos) ── */
.article-media-box {
  margin: 36px 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--line-s);
  background: var(--bg-soft);
}
.article-img {
  width: 100%;
  height: auto;
  display: block;
}
.article-video {
  width: 100%;
  max-height: 540px;
  display: block;
  background: #000;
}
.article-media-caption {
  font-size: 13px;
  color: var(--muted);
  text-align: center;
  padding: 12px 16px;
  background: var(--bg-elev);
  border-top: 1px solid var(--line);
  margin: 0;
}

/* ── Footer CTA ── */
.post-cta-box {
  margin-top: 56px;
  padding: 40px;
  border-radius: 16px;
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 28px;
}
.post-cta-info h3 {
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8px;
}
.post-cta-info p {
  font-size: 14.5px;
  color: var(--ink-2);
  line-height: 1.6;
  margin: 0;
}
.post-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--ink);
  color: var(--bg-elev);
  padding: 13px 26px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none !important;
  white-space: nowrap;
  transition: opacity .2s;
}
.post-cta-btn:hover {
  opacity: .88;
}

/* ── Related / 다른 글 카드 섹션 ─────────────────── */
.post-related-section {
  margin-top: 64px;
  padding-top: 48px;
  border-top: 1px solid var(--line);
}
.post-related-header {
  margin-bottom: 24px;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.post-related-title {
  font-family: var(--sans);
  font-size: 19px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.015em;
}
.post-related-sub {
  font-family: var(--mono);
  font-size: 11px;
  color: var(--muted);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.post-related-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}
.related-item-card {
  display: flex;
  flex-direction: column;
  background: var(--bg-elev);
  border: 1px solid var(--line);
  border-radius: 12px;
  overflow: hidden;
  text-decoration: none !important;
  transition: transform 0.25s var(--ease-out), border-color 0.25s, box-shadow 0.25s;
}
.related-item-card:hover {
  transform: translateY(-4px);
  border-color: var(--line-s);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
}
.related-item-thumb-box {
  width: 100%;
  aspect-ratio: 16 / 9;
  background: #0f172a;
  overflow: hidden;
  position: relative;
}
.related-item-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}
.related-item-card:hover .related-item-thumb {
  transform: scale(1.03);
}
.related-item-content {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}
.related-item-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
  font-family: var(--mono);
  font-size: 11px;
}
.related-item-badge {
  color: #0284c7;
  font-weight: 600;
  letter-spacing: 0.04em;
}
.related-item-title {
  font-family: var(--sans);
  font-size: 16px;
  font-weight: 700;
  line-height: 1.45;
  color: var(--ink);
  margin-bottom: 8px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.related-item-desc {
  font-size: 13.5px;
  line-height: 1.6;
  color: var(--ink-2);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.related-item-link-text {
  margin-top: auto;
  padding-top: 14px;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  color: #0284c7;
  display: flex;
  align-items: center;
  gap: 4px;
}

@media (max-width: 640px) {
  .post-related-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<article class="post-wrap">
  <div class="post-nav-bar">
    <a href="/" class="post-back-link">
      <span>←</span>
      <span>작업실 홈으로</span>
    </a>
    <span class="post-badge">{post.data.category}</span>
  </div>

  <header class="post-header">
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-lead">{post.data.summary}</p>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <span>작업 기록</span>
    </div>
  </header>

  <div class="post-body">
    <Content />
  </div>

  <!-- 연관 실전 자료실 글 추천 -->
  {relatedLabList.length > 0 && (
    <section class="post-related-section">
      <div class="post-related-header">
        <h3 class="post-related-title">함께 보면 좋은 실전 자료실 & 코드</h3>
        <span class="post-related-sub">LAB RESOURCES</span>
      </div>

      <div class="post-related-grid">
        {relatedLabList.map(item => (
          <a href={`/lab/${item.id}/`} class="related-item-card">
            <div class="related-item-thumb-box">
              <img 
                src={item.data.thumbnail || "/images/lab/thumb-01-blog-volume.png"} 
                alt={item.data.title} 
                class="related-item-thumb" 
                loading="lazy" 
              />
            </div>
            <div class="related-item-content">
              <div class="related-item-meta">
                <span class="related-item-badge">{item.data.categoryBadge || 'TWONELAB'}</span>
                <span style="color:var(--muted);">·</span>
                <span style="color:var(--muted);">{item.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              </div>
              <h4 class="related-item-title">{item.data.title}</h4>
              <p class="related-item-desc">{item.data.summary}</p>
              <div class="related-item-link-text">파이썬 코드 & 노하우 확인 →</div>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- End of Post CTA Box -->
  <div class="post-cta-box">
    <div class="post-cta-info">
      <h3>네이버 블로그 키워드 자동 추출기</h3>
      <p>단어 하나 입력으로 롱테일 확장부터 엑셀 정리까지 한 번에 끝내는 실전 도구입니다.</p>
    </div>
    <a href="https://kmong.com/gig/785584" target="_blank" rel="noopener noreferrer" class="post-cta-btn">
      크몽에서 살펴보기 ↗
    </a>
  </div>
</article>
</Layout>

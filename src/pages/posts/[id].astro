---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.date.toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric'
});
---

<Layout title={`${post.data.title} — Twoneworks`} description={post.data.summary}>
<style is:global>
.post-wrap {
  max-width: 780px;
  margin: 0 auto;
  padding: 64px 24px 112px;
}

.post-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.post-back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--mono);
  font-size: 12px;
  letter-spacing: 0.08em;
  color: var(--muted);
  text-decoration: none !important;
  transition: color .2s;
}
.post-back-link:hover {
  color: var(--ink);
}
.post-badge {
  font-family: var(--mono);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #0284c7;
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  padding: 4px 10px;
  border-radius: 6px;
  font-weight: 600;
}

.post-header {
  margin-bottom: 48px;
}
.post-title {
  font-family: var(--sans);
  font-weight: 700;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.3;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin-bottom: 20px;
}
.post-lead {
  font-size: 17px;
  line-height: 1.75;
  color: var(--ink-2);
  font-weight: 400;
  margin-bottom: 18px;
}
.post-meta {
  font-family: var(--mono);
  font-size: 12px;
  color: var(--muted);
  display: flex;
  gap: 16px;
}

.post-body {
  font-size: 16.5px;
  line-height: 1.85;
  color: var(--ink);
}
.post-body h2 {
  font-family: var(--sans);
  font-weight: 700;
  font-size: 24px;
  letter-spacing: -0.02em;
  margin: 2.6em 0 0.9em;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--line);
  color: var(--ink);
}
.post-body h3 {
  font-family: var(--sans);
  font-weight: 600;
  font-size: 19px;
  letter-spacing: -0.015em;
  margin: 2em 0 0.7em;
  color: var(--ink);
}
.post-body p {
  margin-bottom: 1.5em;
}
.post-body ol, .post-body ul {
  margin: 1.2em 0 1.6em 1.4em;
  padding: 0;
}
.post-body li {
  margin-bottom: 0.6em;
  line-height: 1.75;
}
.post-body hr {
  border: 0;
  border-top: 1px solid var(--line);
  margin: 3.5em 0;
}
.post-body blockquote {
  margin: 2em 0;
  padding: 20px 24px;
  background: var(--bg-soft);
  border-left: 3px solid #0284c7;
  border-radius: 0 8px 8px 0;
  font-size: 15.5px;
  color: var(--ink-2);
}

/* ── Media Box (Images & Videos) ── */
.article-media-box {
  margin: 36px 0;
  border-radius: 12px;
  overflow: hidden;
  border: 1px solid var(--line-s);
  background: var(--bg-soft);
}
.article-img {
  width: 100%;
  height: auto;
  display: block;
}
.article-video {
  width: 100%;
  max-height: 540px;
  display: block;
  background: #000;
}
.article-media-caption {
  font-size: 13px;
  color: var(--muted);
  text-align: center;
  padding: 12px 16px;
  background: var(--bg-elev);
  border-top: 1px solid var(--line);
  margin: 0;
}

/* ── Footer CTA ── */
.post-cta-box {
  margin-top: 56px;
  padding: 40px;
  border-radius: 16px;
  background: var(--bg-soft);
  border: 1px solid var(--line-s);
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 28px;
}
.post-cta-info h3 {
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8px;
}
.post-cta-info p {
  font-size: 14.5px;
  color: var(--ink-2);
  line-height: 1.6;
  margin: 0;
}
.post-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--ink);
  color: var(--bg-elev);
  padding: 13px 26px;
  border-radius: 8px;
  font-weight: 600;
  font-size: 14px;
  text-decoration: none !important;
  white-space: nowrap;
  transition: opacity .2s;
}
.post-cta-btn:hover {
  opacity: .88;
}

@media (max-width: 768px) {
  .post-wrap { padding: 40px 20px 80px; }
  .post-cta-box { flex-direction: column; align-items: flex-start; padding: 28px 24px; }
}
</style>

<article class="post-wrap">
  <div class="post-nav-bar">
    <a href="/" class="post-back-link">
      <span>←</span>
      <span>작업실 홈으로</span>
    </a>
    <span class="post-badge">{post.data.category}</span>
  </div>

  <header class="post-header">
    <h1 class="post-title">{post.data.title}</h1>
    <p class="post-lead">{post.data.summary}</p>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formattedDate}</time>
      <span>·</span>
      <span>작업 기록</span>
    </div>
  </header>

  <div class="post-body">
    <Content />
  </div>

  <!-- End of Post CTA Box -->
  <div class="post-cta-box">
    <div class="post-cta-info">
      <h3>네이버 블로그 키워드 자동 추출기</h3>
      <p>단어 하나 입력으로 롱테일 확장부터 엑셀 정리까지 한 번에 끝내는 실전 도구입니다.</p>
    </div>
    <a href="https://kmong.com/gig/785584" target="_blank" rel="noopener noreferrer" class="post-cta-btn">
      크몽에서 살펴보기 ↗
    </a>
  </div>
</article>
</Layout>

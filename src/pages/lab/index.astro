---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const labPosts = await getCollection('lab', ({ data }) => !data.draft);
labPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Lab (자료실) — Twoneworks" description="숏폼에서 소개한 실전 파이썬 코드와 원클릭 복붙용 AI 프롬프트 자료실">
<style>
.list-wrap {
  max-width: 820px;
  margin: 0 auto;
  padding: 80px 24px 120px;
}
.list-head {
  margin-bottom: 56px;
}
.list-eyebrow {
  font-family: var(--mono);
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: #0284c7;
  margin-bottom: 16px;
}
.list-title {
  font-family: var(--sans);
  font-size: clamp(32px, 4.5vw, 44px);
  font-weight: 700;
  letter-spacing: -.03em;
  color: var(--ink);
  margin-bottom: 16px;
}
.list-desc {
  font-size: 16.5px;
  line-height: 1.7;
  color: var(--ink-2);
}

.lab-item {
  display: flex;
  gap: 28px;
  align-items: center;
  padding: 24px 28px;
  border-radius: 14px;
  border: 1px solid var(--line);
  background: var(--bg-elev);
  text-decoration: none !important;
  margin-bottom: 20px;
  transition: transform .25s var(--ease-out), border-color .25s, box-shadow .25s;
}
.lab-item:hover {
  transform: translateY(-3px);
  border-color: var(--line-s);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
}
.lab-item-thumb-box {
  width: 220px;
  min-width: 220px;
  aspect-ratio: 16 / 9;
  border-radius: 8px;
  overflow: hidden;
  background: #0f172a;
}
.lab-item-thumb {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .3s ease;
}
.lab-item:hover .lab-item-thumb {
  transform: scale(1.04);
}
.lab-item-content {
  flex: 1;
  min-width: 0;
}
.lab-item-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10px;
  font-family: var(--mono);
  font-size: 11.5px;
}
.lab-item-badge {
  background: rgba(2, 132, 199, 0.1);
  color: #0284c7;
  font-weight: 700;
  letter-spacing: .08em;
  padding: 3px 8px;
  border-radius: 4px;
  border: 1px solid rgba(2, 132, 199, 0.25);
}
.lab-item-date {
  color: var(--muted);
}
.lab-item-title {
  font-family: var(--sans);
  font-size: 20px;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -.02em;
  line-height: 1.4;
  margin-bottom: 10px;
}
.lab-item-summary {
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink-2);
  margin: 0 0 14px;
}
.lab-item-action {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: var(--mono);
  font-size: 12px;
  font-weight: 600;
  color: #0284c7;
}

@media (max-width: 680px) {
  .lab-item {
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    padding: 20px;
  }
  .lab-item-thumb-box {
    width: 100%;
    min-width: 100%;
  }
}
</style>

<div class="list-wrap">
  <div class="list-head">
    <p class="list-eyebrow">LAB · 기술자료실</p>
    <h1 class="list-title">실전 자동화 도구 & AI 프롬프트</h1>
    <p class="list-desc">
      유튜브와 인스타 숏폼에서 소개한 실전 파이썬 소스코드와 원클릭 복붙용 AI 프롬프트 원문입니다.
      모두 직접 검증을 마친 리소스로, 자유롭게 복사하여 실무에 적용해 보세요.
    </p>
  </div>

  <div class="lab-list">
    {labPosts.map(post => (
      <a href={`/lab/${post.id}/`} class="lab-item">
        {post.data.thumbnail && (
          <div class="lab-item-thumb-box">
            <img 
              src={post.data.thumbnail} 
              alt={post.data.title} 
              class="lab-item-thumb" 
              loading="lazy" 
            />
          </div>
        )}
        <div class="lab-item-content">
          <div class="lab-item-top">
            <span class="lab-item-badge">{post.data.categoryBadge || "AI RESOURCE"}</span>
            <time class="lab-item-date">
              {post.data.date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <h2 class="lab-item-title">{post.data.title}</h2>
          <p class="lab-item-summary">{post.data.summary}</p>
          <div class="lab-item-action">
            프롬프트 & 코드 보기 →
          </div>
        </div>
      </a>
    ))}
  </div>
</div>
</Layout>

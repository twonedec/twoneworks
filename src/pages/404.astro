---
import Layout from '../layouts/Layout.astro';
---

<Layout title="페이지를 찾을 수 없습니다 — Twoneworks">
<div style="max-width: 600px; margin: 120px auto; padding: 0 24px; text-align: center;">
  <p style="font-family: var(--mono); font-size: 14px; color: var(--muted); margin-bottom: 16px;">404 ERROR</p>
  <h1 style="font-size: 32px; font-weight: 700; margin-bottom: 16px;">요청하신 페이지가 없습니다.</h1>
  <p style="color: var(--ink-2); line-height: 1.6; margin-bottom: 32px;">주소가 잘못 입력되었거나 변경되었을 수 있습니다.</p>
  <a href="/" style="display: inline-block; background: var(--ink); color: var(--bg-elev); padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;">Twoneworks 홈으로 →</a>
</div>
</Layout>
